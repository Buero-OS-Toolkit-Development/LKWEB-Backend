<html>
    <head>
        <title>Bank</title>
        <link rel="stylesheet" href="https://buero-os-toolkit-development.github.io/LKWEB-Backend/styling/style.css"/>
        <meta name="author" content="Leander Kafemann"/>
        <link rel="icon" href="/pwa/iconPython.png"/>
        <link rel="manifest" href="/pwa/manifest.json"/>
        <script src="https://buero-os-toolkit-development.github.io/BueroWebKit/js/cookies.js"></script>
        <script src="https://buero-os-toolkit-development.github.io/LKWEB-Backend/js/bankMenu.js"></script>
    </head>
    <body>
        <div class="centerer">
            <div class="login_box">
                <div class="clearfix">
                    <h2 style="margin: 50px;">Bank</h2>
                    <div style="margin-left: 50px; margin-right: 50px;">
                        <p>
                            Welcome to your bank account.<br/>
                            You have <b>{}</b> € available.
                        </p>
                        <button class="login_button" onclick="logout();">Logout</button>
                    </div>
                    <script>
                        let sessionid = "{}";
                        if (getCookie("sessionid", document.cookie) == "") {
                            setCookie("sessionid", sessionid, 7);
                        } else {
                            renewCookie("sessionid", 7)
                        }
                    </script>
                </div>
            </div>
        </div>
    </body>
</html>